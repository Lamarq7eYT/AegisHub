  "rulesOfEngagement": [
    "Test only GitHub-operated services and in-scope targets using accounts and resources controlled by the researcher.",
    "Do not perform social engineering, phishing, physical attacks, DDoS, spam, large-scale scanning, scraping, or excessive traffic.",
    "Do not intentionally access another person’s PII; limit returned data and stop immediately on suspected exposure.",
    "Keep reports private, include clear reproduction steps, and do not publicly disclose before a fix is available."
  ],
  "inScopeTargets": [
    "github.com",
    "githubassets.com",
    "githubusercontent.com",
    "githubapp.com",
    "githubwebhooks.net",
    "github.net",
    "npmjs.com",
    "npmjs.org",
    "GitHub CLI",
    "GitHub Desktop",
    "GitHub Mobile",
    "GitHub Enterprise Server",
    "GitHub Enterprise Cloud"
  ],
